// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  accounts      Account[]
  sessions      Session[]
  bookings      Booking[]
  ownedShops    Barbershop[]
}

model Barbershop {
  id       String    @id @default(uuid())
  name     String
  address  String
  imageUrl String
  ownerId String?
  owner User? @relation(fields: [ownerId], references: [id])
  phone String @default("")
  description String @default("")
  timezone String @default("America/Sao_Paulo")
  openingMinute Int @default(540)
  closingMinute Int @default(1260)
  workingDays Int[] @default([1, 2, 3, 4, 5, 6])
  minimumNoticeMinutes Int @default(60)
  bookingHorizonDays Int @default(60)
  cancellationNoticeMinutes Int @default(120)
  active Boolean @default(true)
  staff Staff[]
  services Service[]
  bookings Booking[]
}

model Service {
  id           String     @id @default(uuid())
  name         String
  price        Decimal    @db.Decimal(10, 2)
  durationMinutes Int @default(45)
  active Boolean @default(true)
  barbershopId String
  barbershop   Barbershop @relation(fields: [barbershopId], references: [id])
  description  String
  bookings     Booking[]
  imageUrl     String
}

model Booking {
  id          String     @id @default(uuid())
  userId      String
  user        User       @relation(fields: [userId], references: [id])
  serviceId   String
  service     Service    @relation(fields: [serviceId], references: [id])
  barbershopId String
  barbershop  Barbershop @relation(fields: [barbershopId], references: [id])
  date        DateTime
  endDate DateTime
  status BookingStatus @default(CONFIRMED)
  price Decimal @db.Decimal(10, 2)
  serviceName String
  staffId String
  staff Staff @relation(fields: [staffId], references: [id])
  createdAt DateTime @default(now())
  cancelledAt DateTime?
  @@index([barbershopId, date])
  @@index([staffId, date, endDate])
  @@index([userId, date])
}

enum BookingStatus {
  CONFIRMED
  COMPLETED
  CANCELLED
  NO_SHOW
}

model Staff {
  id String @id @default(cuid())
  name String
  active Boolean @default(true)
  barbershopId String
  barbershop Barbershop @relation(fields: [barbershopId], references: [id])
  bookings Booking[]
  blocks ScheduleBlock[]
  @@index([barbershopId])
}

model ScheduleBlock {
  id String @id @default(cuid())
  staffId String
  staff Staff @relation(fields: [staffId], references: [id])
  start DateTime
  end DateTime
  reason String @default("Indisponível")
  @@index([staffId, start, end])
}

model EmailDelivery {
  id String @id @default(cuid())
  eventKey String @unique
  recipient String
  subject String
  body String
  state String @default("PENDING")
  attempts Int @default(0)
  lastAttemptAt DateTime?
  lastError String?
  createdAt DateTime @default(now())
  sentAt DateTime?
}


model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}